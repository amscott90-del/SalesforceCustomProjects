<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Portfolio Document Generator</masterLabel>
    <targets>
        <target>lightning__FlowScreen</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="recordId" type="String" label="Record ID" role="inputOnly" required="true"/>
            <property name="documentTemplateId" type="String" label="Document Template ID" role="inputOnly" required="true"/>
            <property name="documentTitle" type="String" label="Document Title" role="inputOnly" default="Quote"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
