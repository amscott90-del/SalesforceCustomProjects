<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Quote Line Draft Editor</masterLabel>
    <description>Flow screen component that lets users add/edit QuoteLineItem draft rows and calculate a unit override from a total override.</description>
    <targets>
        <target>lightning__FlowScreen</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="quoteId" type="String" label="Quote Id" description="Pass the Quote record Id."/>
            <property name="overrideFieldApiName" type="String" label="Override Price Field API Name" default="Unit_Price__c"/>
            <property name="startDateFieldApiName" type="String" label="Start Date Field API Name" default="StartDate"/>
            <property name="endDateFieldApiName" type="String" label="End Date Field API Name" default="EndDate"/>
            <property name="title" type="String" label="Title" default="Quote Lines"/>
            <property name="showUnitPrice" type="Boolean" label="Show Unit Price" default="true"/>
            <property name="maxProductResults" type="Integer" label="Max Product Search Results" default="25"/>
            <property name="saved" type="Boolean" label="Saved" role="outputOnly"/>
        </targetConfig>
        <targetConfig targets="lightning__RecordPage">
            <property name="overrideFieldApiName" type="String" label="Override Price Field API Name" default="Unit_Price__c"/>
            <property name="startDateFieldApiName" type="String" label="Start Date Field API Name" default="StartDate"/>
            <property name="endDateFieldApiName" type="String" label="End Date Field API Name" default="EndDate"/>
            <property name="title" type="String" label="Title" default="Quote Lines"/>
            <property name="showUnitPrice" type="Boolean" label="Show Unit Price" default="true"/>
            <property name="maxProductResults" type="Integer" label="Max Product Search Results" default="25"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
